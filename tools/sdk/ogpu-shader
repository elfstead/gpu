#!/usr/bin/env python3
"""Generate a checked C interface; all input/output locations are caller-owned."""
import argparse
import importlib.util
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--source", required=True, type=Path)
parser.add_argument("--output", required=True, type=Path)
parser.add_argument("--build-dir", required=True, type=Path)
parser.add_argument("--name", required=True)
parser.add_argument("--stage", required=True, choices=("compute", "vertex", "fragment"))
parser.add_argument("--native-heaps", action="store_true", help="select the native descriptor-heap compiler profile")
parser.add_argument("--check", action="store_true")
adapter = Path(__file__).resolve().parents[1] / "share/ogpu/tools/generate.py"
spec = importlib.util.spec_from_file_location("ogpu_generator", adapter)
generate = importlib.util.module_from_spec(spec)
spec.loader.exec_module(generate)
generate.build_inputs.add_options(parser)
args = parser.parse_args()
generate.build_inputs.validate_options(args)
info = {} if args.manifest else None
reflection, assembly, binary = generate.compile_source(args.source, args.build_dir,
                                                       os.getenv("SLANGC", "slangc"), args.stage, args.native_heaps,
                                                       args.include_dir, info)
content = generate.header(reflection, assembly, binary, args.source.read_bytes(), args.name)
generate.build_inputs.publish(args.output, content, args, [info], "stale generated interface")
print("Installed shader interface generation PASS")
