#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Input { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Output { float v[]; };
layout(push_constant, std430) uniform Root {
    Input a; Input b; Output c;
    uint m; uint n; uint k; uint operation;
} r;
shared float partial[64];
void main() {
    uint lane = gl_LocalInvocationID.x;
    if (r.operation == 1u || r.operation == 4u) {
        uint i = gl_GlobalInvocationID.x;
        if (i < r.m * r.n)
            r.c.v[i] = r.operation == 1u ? r.a.v[i] + r.b.v[i % r.k]
                : r.a.v[(i % r.m) * r.n + i / r.m];
        return;
    }
    // Exactly one workgroup per row; no subgroup-width assumption or FP atomics.
    uint base = gl_WorkGroupID.x * r.m;
    float scale = uintBitsToFloat(r.k);
    float value = r.operation == 2u ? 0.0 : -3.402823466e38;
    for (uint i = lane; i < r.m; i += 64u) {
        float x = r.a.v[base + i];
        value = r.operation == 2u ? value + x * x : max(value, x * scale);
    }
    partial[lane] = value;
    barrier();
    for (uint step = 32u; step > 0u; step /= 2u) {
        if (lane < step) partial[lane] = r.operation == 2u
            ? partial[lane] + partial[lane + step] : max(partial[lane],partial[lane + step]);
        barrier();
    }
    float row_value = partial[0];
    if (r.operation == 2u) {
        float inverse_rms = inversesqrt(row_value / float(r.m) + scale);
        for (uint i = lane; i < r.m; i += 64u) r.c.v[base+i] = r.a.v[base+i] * inverse_rms;
    } else {
        // Finish all reads of the max before reusing the same shared memory.
        barrier();
        value = 0.0;
        for (uint i = lane; i < r.m; i += 64u) value += exp(r.a.v[base+i] * scale - row_value);
        partial[lane] = value;
        barrier();
        for (uint step = 32u; step > 0u; step /= 2u) {
            if (lane < step) partial[lane] += partial[lane+step];
            barrier();
        }
        for (uint i = lane; i < r.m; i += 64u)
            r.c.v[base+i] = exp(r.a.v[base+i] * scale - row_value) / partial[0];
    }
}
