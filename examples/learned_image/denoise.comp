#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Read { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Write { float v[]; };
layout(push_constant, std430) uniform Root {
    Read input_data; Read weights; Read hidden; Write output_data; uint count; uint reserved;
} root;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= root.count) return;
    precise float value = root.weights.v[88];
    for (uint c = 0; c < 8; ++c) value += root.hidden.v[i * 8u + c] * root.weights.v[80u + c];
    root.output_data.v[i] = clamp(root.input_data.v[i] + value, 0.0, 1.0);
}
