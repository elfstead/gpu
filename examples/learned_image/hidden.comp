#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Read { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Write { float v[]; };
layout(push_constant, std430) uniform Root {
    Read input_data; Read weights; Write output_data; uint width; uint height;
} root;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= root.width * root.height * 8u) return;
    uint channel = i % 8u, pixel = i / 8u;
    int x = int(pixel % root.width), y = int(pixel / root.width);
    precise float value = root.weights.v[72u + channel];
    for (int ky = -1; ky <= 1; ++ky) for (int kx = -1; kx <= 1; ++kx) {
        int sx = clamp(x + kx, 0, int(root.width) - 1);
        int sy = clamp(y + ky, 0, int(root.height) - 1);
        uint k = channel * 9u + uint((ky + 1) * 3 + kx + 1);
        value += (root.input_data.v[uint(sy) * root.width + uint(sx)] - 0.5) * root.weights.v[k];
    }
    root.output_data.v[i] = max(0.0, value);
}
