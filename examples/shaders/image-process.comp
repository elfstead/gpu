#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Input {
    uint pixels[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Output {
    uint pixels[];
};
layout(push_constant, std430) uniform Root {
    Input source;
    Output destination;
    uint width;
    uint height;
} root;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= root.width * root.height) return;
    uint x = i % root.width;
    uint y = i / root.width;
    uint rgba = root.source.pixels[(root.height - 1u - y) * root.width + x];
    // Little-endian RGBA8: flip vertically, swap R/B, invert G, preserve A.
    root.destination.pixels[i] = ((rgba >> 16u) & 255u)
        | ((rgba ^ 0x0000ff00u) & 0x0000ff00u)
        | ((rgba & 255u) << 16u) | (rgba & 0xff000000u);
}
